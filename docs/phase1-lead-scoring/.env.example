# Database connection used by the host application.
DATABASE_URL=

# Public application base URL used for unsubscribe links.
APP_URL=http://localhost:3000

# Local Ollama-compatible endpoint and model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Keep disabled for this handoff. Do not set to true without separate approval.
OUTREACH_SENDING_ENABLED=false

# Future provider settings belong in the deployment secret manager, not Git.
# OUTREACH_EMAIL_PROVIDER=
# OUTREACH_FROM_EMAIL=
